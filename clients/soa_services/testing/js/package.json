{
  "name": "@cross-lab-project/soa-service-testing",
  "description": "A crosslab service for testing.",
  "types": "./lib/types/index.d.ts",
  "main": "./lib/cjs/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cross-Lab-Project/crosslab.git"
  },
  "scripts": {
    "build-compile": "rm -rf ./lib/* && tsc -p tsconfig.json && tsc -p tsconfig-cjs.json",
    "build": "npm run build-compile",
    "watch": "tsc -w",
    "format": "prettier . --write",
    "lint": "eslint ."
  },
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js",
      "types": "./lib/types/index.d.ts"
    }
  },
  "author": "Pierre Helbing",
  "license": "MIT",
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@eslint/js": "^9.9.0",
    "@types/eslint__js": "^8.42.3",
    "typescript-eslint": "^8.1.0",
    "eslint": "^9.8.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@cross-lab-project/abstract-messaging-channel": "file:../../../../helper/abstract-messaging-channel",
    "@cross-lab-project/crosslab-messaging-channel": "file:../../../../helper/crosslab-messaging-channel",
    "@cross-lab-project/promise-manager": "file:../../../../helper/promise-manager",
    "@cross-lab-project/soa-client": "file:../../../soa/js",
    "@types/uuid": "^10.0.0",
    "ajv": "^8.17.1",
    "json-schema-to-ts": "^3.1.1",
    "tiny-typed-emitter": "^2.1.0",
    "uuid": "^11.0.2",
    "zod": "^3.25.67"
  }
}
