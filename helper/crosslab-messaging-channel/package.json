{
  "name": "@cross-lab-project/crosslab-messaging-channel",
  "description": "A messaging channel implementation for use in crosslab.",
  "types": "./lib/types/index.d.ts",
  "main": "./lib/cjs/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cross-Lab-Project/crosslab.git"
  },
  "scripts": {
    "build-compile": "rm -rf ./lib/* && tsc -p tsconfig.json && tsc -p tsconfig-cjs.json",
    "build": "npm run build-compile",
    "watch": "tsc -w",
    "format": "prettier . --write",
    "lint": "eslint ."
  },
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js",
      "types": "./lib/types/index.d.ts"
    }
  },
  "author": "Pierre Helbing",
  "license": "MIT",
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@eslint/js": "^9.9.0",
    "@types/eslint__js": "^8.42.3",
    "typescript-eslint": "^8.1.0",
    "eslint": "^9.8.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@cross-lab-project/abstract-messaging-channel": "file:../abstract-messaging-channel",
    "@cross-lab-project/soa-client": "file:../../clients/soa/js"
  }
}
